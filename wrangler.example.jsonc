// Copy to `wrangler.jsonc` and fill in your own account-specific values.
// `wrangler.jsonc` is gitignored so ids and proxy hosts stay out of git.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asset-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "triggers": {
    // All three crons run every day (weekends included): snapshots are stored
    // daily, while quotes/FX keep only business days and non-trading days reuse
    // the last close. KRX: UTC 11:30 = KST 20:30. US: UTC 22:00 = KST 07:00 next
    // day (after the US close). FX: UTC 03:00 = KST 12:00 (after Korea Eximbank
    // publishes ~11:00).
    "crons": ["30 11 * * *", "0 22 * * *", "0 3 * * *"]
  },
  "vars": {
    "KIS_ENV": "prod",
    "KIS_BASE_URL": "https://openapi.koreainvestment.com:9443",
    "KIWOOM_ENV": "prod",
    // Caddy reverse-proxy vhost on your IP-whitelisted VPS (see deploy/caddy/).
    "KIWOOM_BASE_URL": "https://kiwoom.proxy.example.com",
    // Caddy reverse proxy for Toss (IP-allowlisted host).
    "TOSS_BASE_URL": "https://toss.proxy.example.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asset-tracker-db",
      "database_id": "<d1-database-id>",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "<kv-namespace-id>"
    }
  ]
}
