# Copy to .dev.vars for `wrangler dev` and the local scripts (never commit).
# `wrangler secret put` only affects the deployed Worker; local runs read this file.

# Per-account KIS credentials as a single-line JSON object keyed by account
# external id (CANO-PRDT). This is the primary credential source.
KIS_CREDENTIALS='{"12345678-01":{"appkey":"your-app-key","appsecret":"your-app-secret"}}'

# KIS environment: prod (real) or vts (paper).
KIS_ENV="prod"

# Shared secret required by POST /sync, /accounts, /runs (x-admin-token header).
ADMIN_TOKEN="change-me"

# Optional: default accounts for `npm run kis:accounts` when no --accounts flag.
# KIS_ACCOUNTS="12345678-01"

# Per-account Kiwoom credentials as a single-line JSON object keyed by account id.
# KIWOOM_CREDENTIALS='{"12345678":{"appkey":"your-app-key","appsecret":"your-app-secret"}}'

# Kiwoom environment: prod (real) or mock (paper).
# KIWOOM_ENV="prod"

# Base URL the Worker calls. Point at the Caddy reverse-proxy vhost so requests
# egress from the IP-whitelisted host (see deploy/caddy/kiwoom.caddy).
# KIWOOM_BASE_URL="https://kiwoom.proxy.example.com"

# Shared secret sent as the X-Kiwoom-Relay header to the reverse proxy.
# KIWOOM_RELAY_SECRET="change-me"

# Optional: default accounts for `npm run kiwoom:accounts` when no flags are given.
# KIWOOM_ACCOUNTS="12345678"

# Korea Eximbank (한국수출입은행) Open API auth key, for the reference FX rate.
# Issue at https://www.koreaexim.go.kr/ir/HPHKIR020M01?apino=2&viewtype=C
# KOREAEXIM_API_KEY="your-auth-key"

# Toss Securities Open API credentials (single user-level OAuth2 client).
# TOSS_CREDENTIALS='{"clientId":"your-client-id","clientSecret":"your-client-secret"}'

# Base URL the Worker calls. Point at the Caddy reverse-proxy vhost so requests
# egress from the IP-allowlisted host (see deploy/caddy/toss.caddy).
# TOSS_BASE_URL="https://toss.proxy.example.com"

# Shared secret sent as the X-Toss-Relay header to the reverse proxy.
# TOSS_RELAY_SECRET="change-me"
